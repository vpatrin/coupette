{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "preview": "vite preview",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "200 kB"
    }
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "^17.1.4",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "_resolutions_comment": "Pinned until upstreams (shadcn, vitest, @tailwindcss/typography) bump their transitive deps — remove each entry when yarn audit passes without it. js-yaml is capped at 4.x, not a floor: openapi-typescript (Redocly) crashes on js-yaml 5",
  "resolutions": {
    "hono": ">=4.12.27",
    "@hono/node-server": ">=2.0.5",
    "postcss": ">=8.5.18",
    "qs": ">=6.15.2",
    "fast-uri": ">=3.1.5",
    "body-parser": ">=2.3.0",
    "eslint/**/brace-expansion": "^1.1.18",
    "**/@typescript-eslint/typescript-estree/**/brace-expansion": ">=5.0.9",
    "**/@ts-morph/common/**/brace-expansion": ">=5.0.9",
    "ip-address": ">=10.1.1",
    "js-yaml": "^4.3.1",
    "@babel/core": ">=7.29.6",
    "@tailwindcss/typography/postcss-selector-parser": ">=7.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
